# ==============================================================================
# ATENEO+ — PLANTILLA DE CONFIGURACIÓN DEL ENTORNO
# Copia este archivo como .env en la raíz del proyecto antes de levantar Docker.
# ==============================================================================

# LLM & IA Resilient Gateway
GEMINI_API_KEY=tu_google_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.7-flash
GEMINI_CIRCUIT_COOLDOWN_SECONDS=300

# Backend Core & Persistencia
HOST=0.0.0.0
PORT=8000
CHROMA_PERSIST_PATH=./data/chroma_db
RAW_PDFS_PATH=./data/raw_pdfs
CASES_FILE_PATH=./cases_data/cases.json

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=tu_clave_secreta_jwt_para_firmar_tokens_msp_ecuador
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
