GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash
HOST=0.0.0.0
PORT=8000
CHROMA_PERSIST_PATH=./data/chroma_db
RAW_PDFS_PATH=./data/raw_pdfs
CASES_FILE_PATH=./cases_data/cases.json

# ALLOWED_ORIGINS controla el CORS del backend:
# - Dejar vacío: solo acepta localhost y LAN (192.168.x.x) — modo seguro por defecto.
# - Poner '*': acepta cualquier origen (Cloudflare Tunnel, AWS, demos públicas).
# - Poner URLs específicas separadas por coma para producción real.
# Ejemplo producción: ALLOWED_ORIGINS=https://ateneo.tudominio.com
# Ejemplo demo pública: ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=
