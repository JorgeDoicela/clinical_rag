    "# 2. Instalación de dependencias de entrenamiento\n",
    "!pip install -q \"sentence-transformers>=3.0.0\" \"datasets>=2.18.0\" \"accelerate>=0.28.0\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Descompresión o subida de Datasets (datasets_fase6.zip)\n",
    "import os, zipfile\n",
    "from pathlib import Path\n",
    "\n",
    "os.makedirs(\"datasets\", exist_ok=True)\n",
    "os.makedirs(\"models/ateneo-bge-m3-ecuador-v2\", exist_ok=True)\n",
    "\n",
    "# Si subiste datasets_fase6.zip, lo descomprime automáticamente:\n",
    "if Path(\"datasets_fase6.zip\").exists():\n",
    "    with zipfile.ZipFile(\"datasets_fase6.zip\", \"r\") as z:\n",
    "        z.extractall(\"datasets\")\n",
    "    print(\"datasets_fase6.zip descomprimido con éxito en datasets/\")\n",
    "else:\n",
    "    print(\"Sube 'datasets_fase6.zip' arrastrándolo al panel izquierdo de archivos de Colab.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Carga y Verificación Criptográfica de Datasets\n",
    "import json, hashlib\n",
    "\n",
    "train_path = Path(\"datasets/retrieval_train.json\") if Path(\"datasets/retrieval_train.json\").exists() else Path(\"retrieval_train.json\")\n",
    "val_path = Path(\"datasets/retrieval_val.json\") if Path(\"datasets/retrieval_val.json\").exists() else Path(\"retrieval_val.json\")\n",
    "\n",
    "assert train_path.exists(), f\"No se encontró {train_path}. Sube datasets_fase6.zip.\"\n",
    "assert val_path.exists(), f\"No se encontró {val_path}. Sube datasets_fase6.zip.\"\n",
    "\n",
    "with open(train_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    train_data = json.load(f)\n",
    "with open(val_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    val_data = json.load(f)\n",
    "\n",
    "train_hash = hashlib.sha256(train_path.read_bytes()).hexdigest()\n",
    "val_hash = hashlib.sha256(val_path.read_bytes()).hexdigest()\n",
    "\n",
    "print(f\"Train samples: {len(train_data)} | SHA-256: {train_hash[:16]}...\")\n",
    "print(f\"Val samples  : {len(val_data)}   | SHA-256: {val_hash[:16]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Construcción del Evaluador, Evaluación PRE, Fine-Tuning con bfloat16 y Evaluación POST\n",
    "import time\n",
    "from datasets import Dataset\n",
    "from sentence_transformers import SentenceTransformer, SentenceTransformerTrainer, SentenceTransformerTrainingArguments\n",
    "from sentence_transformers.losses import MultipleNegativesRankingLoss\n",
    "from sentence_transformers.evaluation import InformationRetrievalEvaluator\n",
    "\n",
    "# Formatear tripletas\n",
    "train_triplets = [{\"anchor\": item[\"query\"].strip(), \"positive\": item[\"pos\"].strip(), \"negative\": item[\"neg\"].strip()} for item in train_data]\n",
    "train_dataset = Dataset.from_list(train_triplets)\n",
    "\n",
    "# Construir IR Evaluator para Validación\n",
    "corpus, queries, relevant_docs = {}, {}, {}\n",
    "text_to_id = {}\n",
    "for idx, item in enumerate(val_data):\n",
    "    q_id = f\"q_{idx:04d}\"\n",
    "    queries[q_id] = item[\"query\"].strip()\n",
    "    \n",
    "    pos_text = item[\"pos\"].strip()\n",
    "    neg_text = item[\"neg\"].strip()\n",
    "    \n",
    "    if pos_text not in text_to_id:\n",
    "        p_id = f\"doc_pos_{idx:04d}\"\n",
    "        text_to_id[pos_text] = p_id\n",
    "        corpus[p_id] = pos_text\n",
    "    p_id = text_to_id[pos_text]\n",
    "    \n",
    "    if neg_text not in text_to_id:\n",
    "        n_id = f\"doc_neg_{idx:04d}\"\n",
    "        text_to_id[neg_text] = n_id\n",
    "        corpus[n_id] = neg_text\n",
    "        \n",
    "    relevant_docs[q_id] = {p_id}\n",
    "\n",
    "evaluator = InformationRetrievalEvaluator(\n",
    "    queries=queries, corpus=corpus, relevant_docs=relevant_docs,\n",
    "    name=\"ateneo_val_evaluator\", mrr_at_k=[1, 5, 10], ndcg_at_k=[1, 5, 10], accuracy_at_k=[1, 3, 5],\n",
    "    show_progress_bar=True\n",
    ")\n",
    "\n",
    "# Cargar BGE-M3 base\n",
    "model = SentenceTransformer(\"BAAI/bge-m3\", device=\"cuda\")\n",
    "model.max_seq_length = 512\n",
    "\n",
    "# EVALUACIÓN PRE-ENTRENAMIENTO (BASELINE)\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"EVALUACIÓN PRE-ENTRENAMIENTO (BASELINE BGE-M3 BASE SIN FT)\")\n",
    "print(\"=\"*80)\n",
    "pre_metrics = evaluator(model)\n",
    "\n",
    "# Loss MNRL con escala 50.0 (tau = 0.02)\n",
    "loss_fn = MultipleNegativesRankingLoss(model, scale=50.0)\n",
    "\n",
    "# Argumentos calibrados para NVIDIA A100 40GB\n",
    "training_args = SentenceTransformerTrainingArguments(\n",
    "    output_dir=\"checkpoints_bge_m3\",\n",
    "    num_train_epochs=5,\n",
    "    per_device_train_batch_size=32,\n",
    "    per_device_eval_batch_size=32,\n",
    "    learning_rate=2e-5,\n",
    "    warmup_ratio=0.10,\n",
    "    lr_scheduler_type=\"cosine\",\n",
    "    optim=\"adamw_torch\",\n",
    "    weight_decay=0.01,\n",
    "    bf16=True, # bfloat16 nativo en la A100\n",
    "    eval_strategy=\"epoch\",\n",
    "    save_strategy=\"epoch\",\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"ateneo_val_evaluator_cosine_mrr@5\",\n",
    "    greater_is_better=True,\n",
    "    logging_steps=10,\n",
    "    report_to=\"none\",\n",
    "    seed=42,\n",
    ")\n",
    "\n",
    "trainer = SentenceTransformerTrainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=train_dataset,\n",
    "    loss=loss_fn,\n",
    "    evaluator=evaluator,\n",
    ")\n",
    "\n",
    "print(\"\\n=== INICIANDO ENTRENAMIENTO EN NVIDIA A100 ===\")\n",
    "t0 = time.time()\n",
    "trainer.train()\n",
    "print(f\"Entrenamiento completado en {(time.time() - t0)/60.0:.2f} minutos.\")\n",
    "\n",
    "# Guardar modelo definitivo\n",
    "final_path = \"models/ateneo-bge-m3-ecuador-v2\"\n",
    "model.save_pretrained(final_path)\n",
    "print(f\"Modelo final exportado en: {final_path}\")\n",
    "\n",
    "# EVALUACIÓN POST-ENTRENAMIENTO (ATENEO+ FINE-TUNED)\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"EVALUACIÓN POST-ENTRENAMIENTO (ATENEO+ BGE-M3 RE-ENTRENADO)\")\n",
    "print(\"=\"*80)\n",
    "post_metrics = evaluator(model)\n",
    "\n",
    "# Generar Cuadro Comparativo PRE vs POST\n",
    "metric_keys = [\n",
    "    (\"Accuracy@1 (Hit@1)\", \"ateneo_val_evaluator_cosine_accuracy@1\"),\n",
    "    (\"Accuracy@5 (Hit@5)\", \"ateneo_val_evaluator_cosine_accuracy@5\"),\n",
    "    (\"MRR@1\", \"ateneo_val_evaluator_cosine_mrr@1\"),\n",
    "    (\"MRR@5\", \"ateneo_val_evaluator_cosine_mrr@5\"),\n",
    "    (\"NDCG@5\", \"ateneo_val_evaluator_cosine_ndcg@5\"),\n",
    "    (\"Precision@5\", \"ateneo_val_evaluator_cosine_precision@5\"),\n",
    "    (\"Recall@5\", \"ateneo_val_evaluator_cosine_recall@5\"),\n",
    "]\n",
    "\n",
    "print(\"\\n\" + \"=\"*90)\n",
    "print(\" CUADRO COMPARATIVO PRE vs. POST FINE-TUNING (PAPER CIENTÍFICO)\")\n",
    "print(\"=\"*90)\n",
    "print(f\" {'Métrica Científica':<25} | {'Baseline (PRE)':<15} | {'Ateneo+ (POST)':<15} | {'Delta (Δ)':<12} | {'Ganancia (%)':<12}\")\n",
    "print(\"-\"*90)\n",
    "\n",
    "latex_rows = []\n",
    "for name, key in metric_keys:\n",
    "    val_pre = float(pre_metrics.get(key, 0.0))\n",
    "    val_post = float(post_metrics.get(key, 0.0))\n",
    "    delta = val_post - val_pre\n",
    "    gain_pct = (delta / val_pre * 100.0) if val_pre > 0.0 else 0.0\n",
    "    print(f\" {name:<25} | {val_pre:15.4f} | {val_post:15.4f} | {delta:+12.4f} | {gain_pct:+11.2f}%\")\n",
    "    latex_rows.append(f\"    {name} & {val_pre:.4f} & {val_post:.4f} & {delta:+.4f} & {gain_pct:+.2f}\\\\% \\\\\\\\\")\n",
    "print(\"=\"*90)\n",
    "\n",
    "# Guardar tabla LaTeX\n",
    "latex_table = \"\\\\begin{table}[htbp]\\n\\\\centering\\n\\\\caption{Comparación empírica Pre vs. Post Fine-Tuning en Ateneo+ BGE-M3 Ecuador v2 (MNRL $\\\\tau=0.02$).}\\n\\\\label{tab:pre_post_retrieval}\\n\\\\begin{tabular}{lcccc}\\n\\\\toprule\\n\\\\textbf{Métrica de Retrieval} & \\\\textbf{Baseline (Pre)} & \\\\textbf{Ateneo+ (Post)} & \\\\textbf{Delta ($\\\\Delta$)} & \\\\textbf{Ganancia (\\\\%)} \\\\\\\\\\n\\\\midrule\\n\" + \"\\n\".join(latex_rows) + \"\\n\\\\bottomrule\\n\\\\end{tabular}\\n\\\\end{table}\"\n",
    "\n",
    "with open(f\"{final_path}/pre_post_table.tex\", \"w\") as f:\n",
    "    f.write(latex_table)\n",
    "print(f\"\\nTabla LaTeX exportada en: {final_path}/pre_post_table.tex\")"
   ]
  },
