# ==========================================
# 1. SECRETOS Y CREDENCIALES (CRÍTICO)
# ==========================================
.env
*.env
**/.env
**/*.env
**/*.env.*
!**/.env.example

# ==========================================
# 2. PYTHON, VIRTUAL ENVS & CACHE
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/.venv/
venv/
**/venv/
ENV/
.pytest_cache/
.coverage
*.log
*.db-wal
*.db-shm

# ==========================================
# 3. BASE VECTORIAL Y PESOS GIGANTES (>100MB)
# ==========================================
# ChromaDB local y checkpoints binarios (preserva carpetas via .gitkeep)
backend/data/chroma_db/*
!backend/data/chroma_db/.gitkeep

backend/data/extracted/*
!backend/data/extracted/.gitkeep
!backend/data/extracted/markdown/
backend/data/extracted/markdown/*
!backend/data/extracted/markdown/.gitkeep

backend/data/models/*
!backend/data/models/.gitkeep

backend/data/processed/
backend/data/ateneo-bge-m3-ecuador/*.safetensors
backend/data/ateneo-bge-m3-ecuador/*.bin
backend/data/ateneo-bge-m3-ecuador/*.pt
backend/data/ateneo-bge-m3-ecuador/checkpoints/
backend/checkpoints/
*.zip
**/*.zip

# ==========================================
# 4. FRONTEND / NODE
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
.dist/
*.local
*.tsbuildinfo
**/*.tsbuildinfo
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# ==========================================
# 5. IDE & OS METADATA
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
